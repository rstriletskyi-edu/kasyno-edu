APP_NAME=Kasyno Edu API
ENVIRONMENT=development
API_PREFIX=/api

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Path to the Firebase service-account key, relative to backend/
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
FIREBASE_PROJECT_ID=edukasyno

# LLM grading. LLM_API_KEY is used only when a session is opened without a key.
# LLM_PROVIDER: openai (default, also any OpenAI-compatible host), google_genai, anthropic.
# Set LLM_BASE_URL for Groq, OpenRouter, or another OpenAI-compatible endpoint.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ANSWER_CHARS=2000
LLM_SESSION_TTL_SECONDS=3600
