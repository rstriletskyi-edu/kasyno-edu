APP_NAME=Kasyno Edu API
ENVIRONMENT=development
API_PREFIX=/api

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Path to the Firebase service-account key, relative to backend/
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
FIREBASE_PROJECT_ID=edukasyno
FIREBASE_DATABASE_URL=https://edukasyno-default-rtdb.europe-west1.firebasedatabase.app/
QUESTIONS_PATH=questions

# LLM grading. LLM_API_KEY is used only when a session is opened without a key.
# A session may override LLM_PROVIDER, LLM_MODEL, and LLM_BASE_URL. These values are the fallback.
# LLM_PROVIDER: openai, ollama, google_genai, anthropic.
# ollama uses the OpenAI-compatible client and needs a base URL, from the session or LLM_BASE_URL.
# Set LLM_BASE_URL for Groq, OpenRouter, or another OpenAI-compatible endpoint.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ANSWER_CHARS=2000
LLM_SESSION_TTL_SECONDS=3600

# Credits awarded from the 0–100 score. linear maps that score onto 0–10.
CREDITS_ENGINE=linear
